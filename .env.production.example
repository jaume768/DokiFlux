# ============================================================
# DokiFlux — Production Environment Variables
# ============================================================
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to git.
# ============================================================

# === AI Provider API Keys ===
OPENAI_API_KEY=sk-your-production-key
ANTHROPIC_API_KEY=sk-ant-your-production-key
GEMINI_API_KEY=AIza-your-production-key

# Multi-key rotation (comma-separated, takes precedence over single key)
# OPENAI_API_KEYS=sk-key1,sk-key2
# ANTHROPIC_API_KEYS=sk-ant-key1,sk-ant-key2
# GEMINI_API_KEYS=AIza-key1,AIza-key2

# === Backend (Django) ===
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE-ME-generate-a-strong-secret-key
DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.prod
ALLOWED_HOSTS=dokiflux.com,www.dokiflux.com
CORS_ALLOWED_ORIGINS=https://dokiflux.com
CSRF_TRUSTED_ORIGINS=https://dokiflux.com
FRONTEND_URL=https://dokiflux.com

# === Database (PostgreSQL) ===
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=dokiflux
POSTGRES_USER=dokiflux
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE-ME-strong-password-here

# === Redis ===
REDIS_URL=redis://:CHANGE-ME-redis-password@redis:6379/0
REDIS_PASSWORD=CHANGE-ME-redis-password

# === Email (Brevo) ===
BREVO_API_KEY=xkeysib-your-production-key
BREVO_SENDER_EMAIL=noreply@dokiflux.com
BREVO_SENDER_NAME=Dokiflux
AUTO_VERIFY_EMAIL=False

# === Google OAuth ===
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# === Stripe (use test keys until ready for live) ===
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PREMIUM_PRICE_ID=price_your-premium-price-id

# === Frontend (Next.js) ===
NEXT_PUBLIC_API_URL=https://dokiflux.com/api
# Canonical site URL (sin slash final). Usado para SEO: OG, sitemap, robots, canonical.
NEXT_PUBLIC_SITE_URL=https://dokiflux.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

META_PIXEL_ID=...
META_CAPI_TOKEN=...
NEXT_PUBLIC_META_PIXEL_ID=...   # mismo valor que META_PIXEL_ID
META_CAPI_TEST_EVENT_CODE=

# === AWS S3 — Project image assets ===
# Bucket used by Django to store user-uploaded project images.
AWS_ACCESS_KEY_ID=AKIA-your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_STORAGE_BUCKET_NAME=dokiflux-project-assets-prod
AWS_S3_REGION_NAME=eu-west-1

# Optional. Leave empty if you use the default S3 public URL.
# Example with CloudFront/custom CDN: assets.dokiflux.com
AWS_S3_CUSTOM_DOMAIN=

# Optional. Leave empty for AWS S3. Use only for S3-compatible providers.
# Example for Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=

# Prefix inside the bucket for uploaded media.
AWS_LOCATION=media
