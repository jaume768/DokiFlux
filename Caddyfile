dokiflux.com {
	# API, admin and static → Backend Django
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /admin/* {
		reverse_proxy backend:8000
	}
	handle /static/* {
		reverse_proxy backend:8000
	}

	# /app/* routes need COOP/COEP for WebContainer (SharedArrayBuffer / WebAssembly)
	handle /app/* {
		header Cross-Origin-Opener-Policy same-origin
		header Cross-Origin-Embedder-Policy credentialless
		reverse_proxy frontend:3000
	}

	# Everything else → Frontend Next.js
	handle {
		reverse_proxy frontend:3000
	}
}

# Redirect www to apex
www.dokiflux.com {
	redir https://dokiflux.com{uri} permanent
}
