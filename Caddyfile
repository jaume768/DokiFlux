dokiflux.com {
	# API, admin and static → Backend Django
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /admin/* {
		reverse_proxy backend:8000
	}
	handle /static/* {
		reverse_proxy backend:8000
	}

	# /app/* routes need COOP/COEP for WebContainer (SharedArrayBuffer / WebAssembly)
	# COOP/COEP are set by Next.js (next.config.ts) so we don't duplicate them here.
	# We only add Referrer-Policy to prevent full URLs from leaking to WebContainer iframes.
	handle /app/* {
		header Referrer-Policy "strict-origin-when-cross-origin"
		reverse_proxy frontend:3000
	}

	# Everything else → Frontend Next.js
	handle {
		reverse_proxy frontend:3000
	}
}

# Redirect www to apex
www.dokiflux.com {
	redir https://dokiflux.com{uri} permanent
}
