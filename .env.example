# === Shared ===
OPENAI_API_KEY=sk-your-api-key-here

# === Backend (Django) ===
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database (handled by docker-compose, override here if needed)
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# POSTGRES_DB=dokiflux
# POSTGRES_USER=dokiflux
# POSTGRES_PASSWORD=dokiflux

# Redis
# REDIS_URL=redis://redis:6379/0

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Email (Brevo) — leave empty in DEV, auto-verify is active
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@dokiflux.com
BREVO_SENDER_NAME=Dokiflux

# Google OAuth — leave empty in DEV if not testing Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auto-verify email (DEV only — set to False in production)
AUTO_VERIFY_EMAIL=True

# === Frontend (Next.js) ===
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
