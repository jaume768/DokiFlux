# === Shared — AI Provider API Keys ===
# Single key (backward compatible)
OPENAI_API_KEY=sk-your-api-key-here
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Multi-key rotation (comma-separated, takes precedence over single key)
# OPENAI_API_KEYS=sk-key1,sk-key2,sk-key3
# ANTHROPIC_API_KEYS=sk-ant-key1,sk-ant-key2
# GEMINI_API_KEYS=AIza-key1,AIza-key2

# === Backend (Django) ===
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database (handled by docker-compose, override here if needed)
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# POSTGRES_DB=dokiflux
# POSTGRES_USER=dokiflux
# POSTGRES_PASSWORD=dokiflux

# Redis
# REDIS_URL=redis://redis:6379/0

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Email (Brevo) — leave empty in DEV, auto-verify is active
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@dokiflux.com
BREVO_SENDER_NAME=Dokiflux
# Destino para los leads del formulario "Solicitar presupuesto"
CONTACT_EMAIL_TO=hola@dokiflux.com

# Google OAuth — leave empty in DEV if not testing Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auto-verify email (DEV only — set to False in production)
AUTO_VERIFY_EMAIL=True

# === Stripe ===
# Get these from https://dashboard.stripe.com/test/apikeys (use TEST keys for dev)
STRIPE_SECRET_KEY=sk_test_...
# Get this from: stripe listen --forward-to localhost:8000/api/billing/webhook/
STRIPE_WEBHOOK_SECRET=whsec_...
# Get this from the product's price in https://dashboard.stripe.com/test/products
STRIPE_PREMIUM_PRICE_ID=price_...
STRIPE_TOPUP_MIN_EUR=5

# === Meta Ads (Pixel + Conversions API) ===
# Pixel/Dataset ID from Meta Events Manager — used by browser Pixel and server CAPI.
# Same value goes into NEXT_PUBLIC_META_PIXEL_ID below (frontend).
META_PIXEL_ID=
# CAPI access token (Events Manager → Settings → Generate access token).
# SERVER-SIDE ONLY — never expose to the browser.
META_CAPI_TOKEN=
# Optional: while testing, paste the code from Events Manager → Test Events
# to make events appear in the test panel instead of production.
META_CAPI_TEST_EVENT_CODE=

# === Frontend (Next.js) ===
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Canonical site URL — used for SEO metadata (OG, sitemap, robots, canonical).
# Production must be the public HTTPS origin (sin slash final).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Stripe publishable key (safe to expose — starts with pk_test_ or pk_live_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Meta Pixel ID (must match META_PIXEL_ID above). Public — exposed to the browser.
NEXT_PUBLIC_META_PIXEL_ID=
